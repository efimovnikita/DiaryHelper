<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DiaryHelper.ViewModels"
             xmlns:models="clr-namespace:DiaryHelper.Models"
             xmlns:controls="clr-namespace:DiaryHelper.Controls"
             x:Class="DiaryHelper.Views.DiaryEntryPage"
             x:DataType="vm:DiaryEntryViewModel"
             Title="{Binding Title}"
             BackgroundColor="#F8FAFC">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior Command="{Binding GoBackCommand}" IsEnabled="True" IsVisible="True" />
    </Shell.BackButtonBehavior>

    <Shell.TitleView>
        <VerticalStackLayout VerticalOptions="Center" Spacing="0">
            <Label Text="{Binding Title}"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="#0F172A"
                   LineBreakMode="TailTruncation" />
            <Label Text="{Binding WordCountStats}"
                   FontSize="11"
                   TextColor="#64748B"
                   LineBreakMode="NoWrap" />
        </VerticalStackLayout>
    </Shell.TitleView>

    <Grid RowDefinitions="*, Auto">
        
        <!-- Sentences History List -->
        <CollectionView Grid.Row="0" 
                        ItemsSource="{Binding Sentences}"
                        EmptyView="{Binding EmptySentencesHint}"
                        Margin="12,8,12,6">
            
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:DiarySentence">
                    <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" Padding="14" Margin="0,4" StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout Spacing="8">
                            
                            <!-- Prompt Question Card (if attached to this sentence) -->
                            <Border IsVisible="{Binding HasPrompt}"
                                    BackgroundColor="#EEF2FF"
                                    Stroke="#C7D2FE"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="10,8">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding PromptQuestion, StringFormat='🤖 {0}'}" 
                                           FontSize="13" 
                                           FontAttributes="Bold" 
                                           TextColor="#4338CA" />
                                    <Label Text="{Binding PromptQuestionTranslation}" 
                                           IsVisible="{Binding HasPromptTranslation}"
                                           FontSize="12" 
                                           FontAttributes="Italic" 
                                           TextColor="#6366F1" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Sentence Text -->
                            <controls:SegmentedLabel Segments="{Binding Segments}" FontSize="16" />

                            <!-- Translation (if present) -->
                            <Label Text="{Binding TranslationText}" 
                                   IsVisible="{Binding HasTranslation}"
                                   FontSize="13" 
                                   FontAttributes="Italic" 
                                   TextColor="#94A3B8" />

                            <!-- Sentence Controls -->
                            <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,4,0,0">
                                <HorizontalStackLayout Grid.Column="0" Spacing="4">
                                    <Button Text="⬆️" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DiaryEntryViewModel}}, Path=MoveUpCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#F1F5F9"
                                            TextColor="#334155"
                                            Padding="10,4"
                                            HeightRequest="34"
                                            CornerRadius="8" />
                                    <Button Text="⬇️" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DiaryEntryViewModel}}, Path=MoveDownCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#F1F5F9"
                                            TextColor="#334155"
                                            Padding="10,4"
                                            HeightRequest="34"
                                            CornerRadius="8" />
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Grid.Column="2" Spacing="6">
                                    <Button Text="✏️" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DiaryEntryViewModel}}, Path=EditSentenceCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#F1F5F9"
                                            TextColor="#334155"
                                            Padding="10,4"
                                            HeightRequest="34"
                                            CornerRadius="8" />
                                    <Button Text="🗑️" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DiaryEntryViewModel}}, Path=DeleteSentenceCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#FEE2E2"
                                            TextColor="#DC2626"
                                            Padding="10,4"
                                            HeightRequest="34"
                                            CornerRadius="8" />
                                </HorizontalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Bottom Input & AI Assistant Area -->
        <Border Grid.Row="1" Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" Padding="14" StrokeShape="RoundRectangle 20,20,0,0">
            <VerticalStackLayout Spacing="10">

                <!-- Active Persona Quick Switcher Chips (Scrollable so never clipped) -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8" Padding="2,2">
                        <Button Text="{Binding PersonaFriendText}" 
                                Command="{Binding SelectPersonaCommand}"
                                CommandParameter="Friend"
                                BackgroundColor="#EEF2FF" TextColor="#4338CA" CornerRadius="12" HeightRequest="32" Padding="12,2" FontSize="12" />
                        <Button Text="{Binding PersonaReporterText}" 
                                Command="{Binding SelectPersonaCommand}"
                                CommandParameter="Reporter"
                                BackgroundColor="#F0FDF4" TextColor="#15803D" CornerRadius="12" HeightRequest="32" Padding="12,2" FontSize="12" />
                        <Button Text="{Binding PersonaSageText}" 
                                Command="{Binding SelectPersonaCommand}"
                                CommandParameter="Sage"
                                BackgroundColor="#FDF4FF" TextColor="#86198F" CornerRadius="12" HeightRequest="32" Padding="12,2" FontSize="12" />
                        <Button Text="{Binding PersonaSparkText}" 
                                Command="{Binding SelectPersonaCommand}"
                                CommandParameter="Spark"
                                BackgroundColor="#FFFBEB" TextColor="#B45309" CornerRadius="12" HeightRequest="32" Padding="12,2" FontSize="12" />
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- Kick Question Active Card -->
                <Border IsVisible="{Binding HasActivePrompt}"
                        BackgroundColor="#EEF2FF"
                        Stroke="#C7D2FE"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="12,10">
                    <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                            <Label Text="{Binding KickQuestionHeader}" FontSize="11" FontAttributes="Bold" TextColor="#6366F1" />
                            <Label Text="{Binding CurrentPromptQuestion}" FontSize="15" FontAttributes="Bold" TextColor="#312E81" />
                            <Label Text="{Binding CurrentPromptQuestionTranslation}" 
                                   IsVisible="{Binding HasPromptTranslationAndEnabled}"
                                   FontSize="13" FontAttributes="Italic" TextColor="#4F46E5" />
                        </VerticalStackLayout>
                        <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4" VerticalOptions="Start">
                            <Button Text="🌐" Command="{Binding TogglePromptTranslationCommand}" BackgroundColor="Transparent" TextColor="#4F46E5" Padding="4" HeightRequest="32" WidthRequest="32" />
                            <Button Text="🔄" Command="{Binding RequestKickQuestionCommand}" BackgroundColor="Transparent" TextColor="#4F46E5" Padding="4" HeightRequest="32" WidthRequest="32" />
                            <Button Text="✕" Command="{Binding DismissPromptCommand}" BackgroundColor="Transparent" TextColor="#94A3B8" Padding="4" HeightRequest="32" WidthRequest="32" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- 1. Formally Correct Sentence Card (Green / Mint) -->
                <Border IsVisible="{Binding IsAnalysisCorrect}"
                        BackgroundColor="#F0FDF4"
                        Stroke="#10B981"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 14"
                        Padding="14,12">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*, Auto">
                            <!-- Green Badge Pill -->
                            <Border Grid.Column="0" 
                                    HorizontalOptions="Start"
                                    BackgroundColor="#DCFCE7" 
                                    Stroke="#86EFAC" 
                                    StrokeThickness="1" 
                                    StrokeShape="RoundRectangle 8" 
                                    Padding="8,3">
                                <Label Text="{Binding CorrectBadgeText}" 
                                       FontSize="11" 
                                       FontAttributes="Bold" 
                                       TextColor="#166534" />
                            </Border>

                            <HorizontalStackLayout Grid.Column="1" Spacing="6">
                                <Button Text="{Binding AddButton}" 
                                        Command="{Binding ConfirmSentenceCommand}" 
                                        BackgroundColor="#10B981" 
                                        TextColor="White" 
                                        FontAttributes="Bold"
                                        CornerRadius="8" 
                                        HeightRequest="30" 
                                        Padding="10,2" 
                                        FontSize="12" />
                                <Button Text="✕" 
                                        Command="{Binding DismissAnalysisCommand}" 
                                        BackgroundColor="Transparent" 
                                        TextColor="#6B7280" 
                                        HeightRequest="30" 
                                        WidthRequest="30" 
                                        Padding="0" />
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- Full sentence displayed cleanly -->
                        <Label Text="{Binding PendingAnalysis.Original}" 
                               FontSize="15" 
                               TextColor="#0F172A" />

                        <!-- Translation in soft emerald -->
                        <Label Text="{Binding PendingAnalysis.Translation}" 
                               FontSize="13" 
                               FontAttributes="Italic" 
                               TextColor="#047857" />
                    </VerticalStackLayout>
                </Border>

                <!-- 2. Corrections Needed Card (Warm Amber / Orange) -->
                <Border IsVisible="{Binding HasAnalysisCorrections}"
                        BackgroundColor="#FFFBEB"
                        Stroke="#F59E0B"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 14"
                        Padding="14,12">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*, Auto">
                            <!-- Amber Badge Pill -->
                            <Border Grid.Column="0" 
                                    HorizontalOptions="Start"
                                    BackgroundColor="#FEF3C7" 
                                    Stroke="#FCD34D" 
                                    StrokeThickness="1" 
                                    StrokeShape="RoundRectangle 8" 
                                    Padding="8,3">
                                <Label Text="{Binding FixesBadgeText}" 
                                       FontSize="11" 
                                       FontAttributes="Bold" 
                                       TextColor="#92400E" />
                            </Border>

                            <HorizontalStackLayout Grid.Column="1" Spacing="6">
                                <Button Text="{Binding ApplyFixButton}" 
                                        Command="{Binding ApplyFixCommand}" 
                                        BackgroundColor="#D97706" 
                                        TextColor="White" 
                                        FontAttributes="Bold"
                                        CornerRadius="8" 
                                        HeightRequest="30" 
                                        Padding="10,2" 
                                        FontSize="12" />
                                <Button Text="✕" 
                                        Command="{Binding DismissAnalysisCommand}" 
                                        BackgroundColor="Transparent" 
                                        TextColor="#6B7280" 
                                        HeightRequest="30" 
                                        WidthRequest="30" 
                                        Padding="0" />
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- Highlighted word segments -->
                        <controls:SegmentedLabel Segments="{Binding PendingAnalysis.Segments}" FontSize="15" />

                        <!-- Translation in warm amber-brown -->
                        <Label Text="{Binding PendingAnalysis.Translation}" 
                               FontSize="13" 
                               FontAttributes="Italic" 
                               TextColor="#78350F" />
                    </VerticalStackLayout>
                </Border>

                <!-- Input Text Area -->
                <Editor Text="{Binding CurrentInput}" 
                        Placeholder="{Binding InputPlaceholder}"
                        HeightRequest="75"
                        BackgroundColor="#F1F5F9"
                        TextColor="#0F172A"
                        AutoSize="Disabled" />

                <!-- Action Toolbar -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                    <Button Grid.Column="0"
                            Text="{Binding CheckButton}"
                            Command="{Binding CheckSentenceCommand}"
                            BackgroundColor="#F1F5F9"
                            TextColor="#334155"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="42"
                            FontSize="13" />

                    <Button Grid.Column="1"
                            Text="{Binding AddButton}"
                            Command="{Binding ConfirmSentenceCommand}"
                            BackgroundColor="#4F46E5"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="42"
                            FontSize="13" />
                </Grid>

                <!-- Export Options Bar -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                    <Button Grid.Column="0"
                            Text="{Binding CopyPureButton}"
                            Command="{Binding CopyPureTextCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#64748B"
                            FontSize="12" />

                    <Button Grid.Column="1"
                            Text="{Binding CopyGuidedButton}"
                            Command="{Binding CopyGuidedDialogueCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#64748B"
                            FontSize="12" />
                </Grid>

            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>
