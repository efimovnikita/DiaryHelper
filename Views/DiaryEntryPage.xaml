<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DiaryHelper.ViewModels"
             xmlns:models="clr-namespace:DiaryHelper.Models"
             xmlns:controls="clr-namespace:DiaryHelper.Controls"
             x:Class="DiaryHelper.Views.DiaryEntryPage"
             x:DataType="vm:DiaryEntryViewModel"
             Title="{Binding Title}"
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="*, Auto">
        
        <!-- Sentences History List -->
        <CollectionView Grid.Row="0" 
                        ItemsSource="{Binding Sentences}"
                        EmptyView="Пока нет добавленных предложений. Напишите первое предложение ниже."
                        Margin="12,12,12,6">
            
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:DiarySentence">
                    <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" Padding="14" Margin="0,4" StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout Spacing="8">
                            
                            <!-- Prompt Question Card (if attached to this sentence) -->
                            <Border IsVisible="{Binding HasPrompt}"
                                    BackgroundColor="#EEF2FF"
                                    Stroke="#C7D2FE"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="10,8">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding PromptQuestion, StringFormat='🤖 {0}'}" 
                                           FontSize="13" 
                                           FontAttributes="Bold" 
                                           TextColor="#4338CA" />
                                    <Label Text="{Binding PromptQuestionTranslation}" 
                                           IsVisible="{Binding HasPromptTranslation}"
                                           FontSize="12" 
                                           FontAttributes="Italic" 
                                           TextColor="#6366F1" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Sentence Text -->
                            <controls:SegmentedLabel Segments="{Binding Segments}" FontSize="16" />

                            <!-- Translation (if present) -->
                            <Label Text="{Binding TranslationText}" 
                                   IsVisible="{Binding HasTranslation}"
                                   FontSize="13" 
                                   FontAttributes="Italic" 
                                   TextColor="#94A3B8" />

                            <!-- Sentence Controls -->
                            <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,4,0,0">
                                <HorizontalStackLayout Grid.Column="0" Spacing="4">
                                    <Button Text="⬆️" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DiaryEntryViewModel}}, Path=MoveUpCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#F1F5F9"
                                            TextColor="#334155"
                                            Padding="10,4"
                                            HeightRequest="34"
                                            CornerRadius="8" />
                                    <Button Text="⬇️" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DiaryEntryViewModel}}, Path=MoveDownCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#F1F5F9"
                                            TextColor="#334155"
                                            Padding="10,4"
                                            HeightRequest="34"
                                            CornerRadius="8" />
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Grid.Column="2" Spacing="6">
                                    <Button Text="✏️" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DiaryEntryViewModel}}, Path=EditSentenceCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#F1F5F9"
                                            TextColor="#334155"
                                            Padding="10,4"
                                            HeightRequest="34"
                                            CornerRadius="8" />
                                    <Button Text="🗑️" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DiaryEntryViewModel}}, Path=DeleteSentenceCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#FEE2E2"
                                            TextColor="#DC2626"
                                            Padding="10,4"
                                            HeightRequest="34"
                                            CornerRadius="8" />
                                </HorizontalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Bottom Input & AI Assistant Area -->
        <Border Grid.Row="1" Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" Padding="14" StrokeShape="RoundRectangle 20,20,0,0">
            <VerticalStackLayout Spacing="10">

                <!-- Active Persona Quick Switcher Chips -->
                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Button Text="🧘 Друг" 
                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DiaryEntryViewModel}}, Path=RequestKickQuestionCommand}"
                            BackgroundColor="#EEF2FF" TextColor="#4338CA" CornerRadius="12" HeightRequest="32" Padding="10,2" FontSize="12" />
                    <Button Text="🕵️ Хроникёр" 
                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DiaryEntryViewModel}}, Path=RequestKickQuestionCommand}"
                            BackgroundColor="#F0FDF4" TextColor="#15803D" CornerRadius="12" HeightRequest="32" Padding="10,2" FontSize="12" />
                    <Button Text="🦉 Философ" 
                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DiaryEntryViewModel}}, Path=RequestKickQuestionCommand}"
                            BackgroundColor="#FDF4FF" TextColor="#86198F" CornerRadius="12" HeightRequest="32" Padding="10,2" FontSize="12" />
                    <Button Text="⚡ Провокатор" 
                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DiaryEntryViewModel}}, Path=RequestKickQuestionCommand}"
                            BackgroundColor="#FFFBEB" TextColor="#B45309" CornerRadius="12" HeightRequest="32" Padding="10,2" FontSize="12" />
                </HorizontalStackLayout>

                <!-- Kick Question Active Card -->
                <Border IsVisible="{Binding HasActivePrompt}"
                        BackgroundColor="#EEF2FF"
                        Stroke="#C7D2FE"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="12,10">
                    <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                            <Label Text="💡 Вопрос AI для вдохновения:" FontSize="11" FontAttributes="Bold" TextColor="#6366F1" />
                            <Label Text="{Binding CurrentPromptQuestion}" FontSize="15" FontAttributes="Bold" TextColor="#312E81" />
                            <Label Text="{Binding CurrentPromptQuestionTranslation}" FontSize="13" FontAttributes="Italic" TextColor="#4F46E5" />
                        </VerticalStackLayout>
                        <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4" VerticalOptions="Start">
                            <Button Text="🔄" Command="{Binding RequestKickQuestionCommand}" BackgroundColor="Transparent" TextColor="#4F46E5" Padding="4" HeightRequest="32" WidthRequest="32" />
                            <Button Text="✕" Command="{Binding DismissPromptCommand}" BackgroundColor="Transparent" TextColor="#94A3B8" Padding="4" HeightRequest="32" WidthRequest="32" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- Grammar Checking Feedback Panel -->
                <Border IsVisible="{Binding HasPendingAnalysis}"
                        BackgroundColor="#FFF7ED"
                        Stroke="#FFEDD5"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="12,10">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="🔎 Анализ предложения" FontSize="12" FontAttributes="Bold" TextColor="#C2410C" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="6">
                                <Button Text="🪄 Применить" 
                                        IsVisible="{Binding PendingAnalysis.HasCorrections}"
                                        Command="{Binding ApplyFixCommand}" 
                                        BackgroundColor="#C2410C" TextColor="White" 
                                        CornerRadius="8" HeightRequest="28" Padding="8,2" FontSize="11" />
                                <Button Text="✕" Command="{Binding DismissAnalysisCommand}" 
                                        BackgroundColor="Transparent" TextColor="#94A3B8" 
                                        HeightRequest="28" WidthRequest="28" Padding="0" />
                            </HorizontalStackLayout>
                        </Grid>

                        <controls:SegmentedLabel Segments="{Binding PendingAnalysis.Segments}" FontSize="15" />
                        <Label Text="{Binding PendingAnalysis.Translation}" FontSize="13" FontAttributes="Italic" TextColor="#78350F" />
                    </VerticalStackLayout>
                </Border>

                <!-- Input Text Area -->
                <Editor Text="{Binding CurrentInput}" 
                        Placeholder="Напишите следующее предложение..."
                        HeightRequest="75"
                        BackgroundColor="#F1F5F9"
                        TextColor="#0F172A"
                        AutoSize="Disabled" />

                <!-- Action Toolbar -->
                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8">
                    <Button Grid.Column="0"
                            Text="💾 Сохранить"
                            Command="{Binding SaveEntryCommand}"
                            BackgroundColor="#0F172A"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="42"
                            FontSize="13" />

                    <Button Grid.Column="1"
                            Text="🔎 Проверить"
                            Command="{Binding CheckSentenceCommand}"
                            BackgroundColor="#F1F5F9"
                            TextColor="#334155"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="42"
                            FontSize="13" />

                    <Button Grid.Column="2"
                            Text="➕ Добавить"
                            Command="{Binding ConfirmSentenceCommand}"
                            BackgroundColor="#4F46E5"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="42"
                            FontSize="13" />
                </Grid>

                <!-- Export Options Bar -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                    <Button Grid.Column="0"
                            Text="📋 Текст дневника"
                            Command="{Binding CopyPureTextCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#64748B"
                            FontSize="12" />

                    <Button Grid.Column="1"
                            Text="📋 Текст + Вопросы AI"
                            Command="{Binding CopyGuidedDialogueCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#64748B"
                            FontSize="12" />
                </Grid>

            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>
