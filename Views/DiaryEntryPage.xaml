<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DiaryHelper.ViewModels"
             xmlns:models="clr-namespace:DiaryHelper.Models"
             xmlns:controls="clr-namespace:DiaryHelper.Controls"
             x:Class="DiaryHelper.Views.DiaryEntryPage"
             x:DataType="vm:DiaryEntryViewModel"
             Title="{Binding Title}"
             BackgroundColor="#F8FAFC">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior Command="{Binding GoBackCommand}" IsEnabled="True" IsVisible="True" />
    </Shell.BackButtonBehavior>

    <Shell.TitleView>
        <VerticalStackLayout VerticalOptions="Center" Spacing="0">
            <Label Text="{Binding Title}"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="#0F172A"
                   LineBreakMode="TailTruncation" />
            <Label Text="{Binding WordCountStats}"
                   FontSize="11"
                   TextColor="#64748B"
                   LineBreakMode="NoWrap" />
        </VerticalStackLayout>
    </Shell.TitleView>

    <Grid RowDefinitions="*, Auto">
        
        <!-- Sentences History List -->
        <CollectionView x:Name="SentencesCollectionView"
                        Grid.Row="0" 
                        ItemsSource="{Binding Sentences}"
                        EmptyView="{Binding EmptySentencesHint}"
                        Margin="12,8,12,6">
            
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:DiarySentence">
                    <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" Padding="14" Margin="0,4" StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout Spacing="8">
                            
                            <!-- Prompt Question Card (if attached to this sentence) -->
                            <Border IsVisible="{Binding HasPrompt}"
                                    BackgroundColor="#EEF2FF"
                                    Stroke="#C7D2FE"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="10,8">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding PromptQuestion, StringFormat='🤖 {0}'}" 
                                           FontSize="13" 
                                           FontAttributes="Bold" 
                                           TextColor="#4338CA" />
                                    <Label Text="{Binding PromptQuestionTranslation}" 
                                           IsVisible="{Binding HasPromptTranslation}"
                                           FontSize="12" 
                                           FontAttributes="Italic" 
                                           TextColor="#6366F1" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Sentence Text -->
                            <controls:SegmentedLabel Segments="{Binding Segments}" FontSize="16" />

                            <!-- Sentence Controls -->
                            <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,4,0,0">
                                <HorizontalStackLayout Grid.Column="0" Spacing="4">
                                    <Button Text="⬆️" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DiaryEntryViewModel}}, Path=MoveUpCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#F1F5F9"
                                            TextColor="#334155"
                                            Padding="10,4"
                                            HeightRequest="34"
                                            CornerRadius="8" />
                                    <Button Text="⬇️" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DiaryEntryViewModel}}, Path=MoveDownCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#F1F5F9"
                                            TextColor="#334155"
                                            Padding="10,4"
                                            HeightRequest="34"
                                            CornerRadius="8" />
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Grid.Column="2" Spacing="6">
                                    <Button Text="✏️" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DiaryEntryViewModel}}, Path=EditSentenceCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#F1F5F9"
                                            TextColor="#334155"
                                            Padding="10,4"
                                            HeightRequest="34"
                                            CornerRadius="8" />
                                    <Button Text="🗑️" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DiaryEntryViewModel}}, Path=DeleteSentenceCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#FEE2E2"
                                            TextColor="#DC2626"
                                            Padding="10,4"
                                            HeightRequest="34"
                                            CornerRadius="8" />
                                </HorizontalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Bottom Input & AI Assistant Area -->
        <Border Grid.Row="1" Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" Padding="14" StrokeShape="RoundRectangle 20,20,0,0">
            <VerticalStackLayout Spacing="10">

                <!-- Active Persona Quick Switcher Chips (Scrollable so never clipped) -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8" Padding="2,2">
                        <Button Text="{Binding PersonaFriendText}" 
                                Command="{Binding SelectPersonaCommand}"
                                CommandParameter="Friend"
                                BackgroundColor="#EEF2FF" TextColor="#4338CA" CornerRadius="12" HeightRequest="32" Padding="12,2" FontSize="12" />
                        <Button Text="{Binding PersonaReporterText}" 
                                Command="{Binding SelectPersonaCommand}"
                                CommandParameter="Reporter"
                                BackgroundColor="#F0FDF4" TextColor="#15803D" CornerRadius="12" HeightRequest="32" Padding="12,2" FontSize="12" />
                        <Button Text="{Binding PersonaSageText}" 
                                Command="{Binding SelectPersonaCommand}"
                                CommandParameter="Sage"
                                BackgroundColor="#FDF4FF" TextColor="#86198F" CornerRadius="12" HeightRequest="32" Padding="12,2" FontSize="12" />
                        <Button Text="{Binding PersonaSparkText}" 
                                Command="{Binding SelectPersonaCommand}"
                                CommandParameter="Spark"
                                BackgroundColor="#FFFBEB" TextColor="#B45309" CornerRadius="12" HeightRequest="32" Padding="12,2" FontSize="12" />
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- Kick-Question Loading Spinner Card -->
                <Border IsVisible="{Binding IsGeneratingPrompt}"
                        BackgroundColor="#EEF2FF"
                        Stroke="#C7D2FE"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="14,12">
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center" HorizontalOptions="Center">
                        <ActivityIndicator IsRunning="{Binding IsGeneratingPrompt}"
                                           IsVisible="{Binding IsGeneratingPrompt}"
                                           Color="#4F46E5"
                                           HeightRequest="22"
                                           WidthRequest="22" />
                        <Label Text="{Binding GeneratingPromptText}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#4338CA"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Kick Question Active Card (Takes Full Width!) -->
                <Border IsVisible="{Binding ShowActivePromptCard}"
                        BackgroundColor="#EEF2FF"
                        Stroke="#C7D2FE"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="14,10">
                    <VerticalStackLayout Spacing="6">
                        <!-- Top Header Row: header on left, actions on right -->
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <Label Grid.Column="0" 
                                   Text="{Binding KickQuestionHeader}" 
                                   FontSize="11" 
                                   FontAttributes="Bold" 
                                   TextColor="#6366F1" 
                                   VerticalOptions="Center" />

                            <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Button Text="🌐" Command="{Binding TogglePromptTranslationCommand}" BackgroundColor="Transparent" TextColor="#4F46E5" Padding="2" HeightRequest="28" WidthRequest="28" />
                                <Button Text="🔄" Command="{Binding RequestKickQuestionCommand}" BackgroundColor="Transparent" TextColor="#4F46E5" Padding="2" HeightRequest="28" WidthRequest="28" />
                                <Button Text="✕" Command="{Binding DismissPromptCommand}" BackgroundColor="Transparent" TextColor="#94A3B8" Padding="2" HeightRequest="28" WidthRequest="28" />
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- Question Text - TAKES FULL 100% WIDTH OF THE CARD! -->
                        <Label Text="{Binding CurrentPromptQuestion}" 
                               FontSize="15" 
                               FontAttributes="Bold" 
                               TextColor="#312E81" />

                        <!-- Translation - ALSO TAKES FULL 100% WIDTH -->
                        <Label Text="{Binding CurrentPromptQuestionTranslation}" 
                               IsVisible="{Binding HasPromptTranslationAndEnabled}"
                               FontSize="13" 
                               FontAttributes="Italic" 
                               TextColor="#4F46E5" />
                    </VerticalStackLayout>
                </Border>

                <!-- 1. Formally Correct Sentence Card (Green / Mint) -->
                <Border IsVisible="{Binding IsAnalysisCorrect}"
                        BackgroundColor="#F0FDF4"
                        Stroke="#10B981"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 14"
                        Padding="14,10">
                    <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto" RowSpacing="6">
                        <!-- Full sentence displayed cleanly -->
                        <Label Grid.Row="0" Grid.Column="0"
                               Text="{Binding PendingAnalysis.Original}" 
                               FontSize="15" 
                               TextColor="#0F172A" />

                        <!-- Dismiss button -->
                        <Button Grid.Row="0" Grid.Column="1"
                                Text="✕" 
                                Command="{Binding DismissAnalysisCommand}" 
                                BackgroundColor="Transparent" 
                                TextColor="#6B7280" 
                                HeightRequest="28" 
                                WidthRequest="28" 
                                Padding="0"
                                VerticalOptions="Start" />

                        <!-- Translation in soft emerald -->
                        <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="{Binding PendingAnalysis.Translation}" 
                               FontSize="13" 
                               FontAttributes="Italic" 
                               TextColor="#047857" />
                    </Grid>
                </Border>

                <!-- 2. Corrections Needed Card (Warm Amber / Orange) -->
                <Border IsVisible="{Binding HasAnalysisCorrections}"
                        BackgroundColor="#FFFBEB"
                        Stroke="#F59E0B"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 14"
                        Padding="14,10">
                    <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, Auto" RowSpacing="6">
                        <!-- Top actions: Apply Fix & Dismiss -->
                        <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6" HorizontalOptions="End">
                            <Button Text="{Binding ApplyFixButton}" 
                                    Command="{Binding ApplyFixCommand}" 
                                    BackgroundColor="#D97706" 
                                    TextColor="White" 
                                    FontAttributes="Bold" 
                                    CornerRadius="8" 
                                    HeightRequest="28" 
                                    Padding="10,2" 
                                    FontSize="12" />
                            <Button Text="✕" 
                                    Command="{Binding DismissAnalysisCommand}" 
                                    BackgroundColor="Transparent" 
                                    TextColor="#6B7280" 
                                    HeightRequest="28" 
                                    WidthRequest="28" 
                                    Padding="0" />
                        </HorizontalStackLayout>

                        <!-- Highlighted word segments -->
                        <controls:SegmentedLabel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                Segments="{Binding PendingAnalysis.Segments}" 
                                                FontSize="15" />

                        <!-- Translation in warm amber-brown -->
                        <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="{Binding PendingAnalysis.Translation}" 
                               FontSize="13" 
                               FontAttributes="Italic" 
                               TextColor="#78350F" />
                    </Grid>
                </Border>

                <!-- Action Toolbar (Check & Add Buttons placed ABOVE the input area) -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                    <Border Grid.Column="0"
                            BackgroundColor="#F1F5F9"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="40">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CheckSentenceCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout InputTransparent="True"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               Spacing="8">
                            <ActivityIndicator IsRunning="{Binding IsChecking}"
                                               IsVisible="{Binding IsChecking}"
                                               Color="#4F46E5"
                                               HeightRequest="18"
                                               WidthRequest="18" />
                            <Label Text="{Binding CheckButtonText}"
                                   TextColor="#334155"
                                   FontAttributes="Bold"
                                   FontSize="13"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <Button Grid.Column="1"
                            Text="{Binding AddButton}"
                            Command="{Binding ConfirmSentenceCommand}"
                            BackgroundColor="#4F46E5"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="40"
                            FontSize="13" />
                </Grid>

                <!-- Input Text Area (Generous vertical room to see multiple lines) -->
                <Editor Text="{Binding CurrentInput}" 
                        Placeholder="{Binding InputPlaceholder}"
                        HeightRequest="95"
                        BackgroundColor="#F1F5F9"
                        TextColor="#0F172A"
                        AutoSize="Disabled" />

                <!-- Export Options Bar (Secondary actions below the input area) -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                    <Button Grid.Column="0"
                            Text="{Binding CopyPureButton}"
                            Command="{Binding CopyPureTextCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#64748B"
                            FontSize="12" />

                    <Button Grid.Column="1"
                            Text="{Binding CopyGuidedButton}"
                            Command="{Binding CopyGuidedDialogueCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#64748B"
                            FontSize="12" />
                </Grid>

            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>
