<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DiaryHelper.ViewModels"
             xmlns:models="clr-namespace:DiaryHelper.Models"
             x:Class="DiaryHelper.Views.WelcomeSettingsPage"
             x:DataType="vm:WelcomeSettingsViewModel"
             Title="{Binding Title}"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="24">
            
            <!-- Header Card -->
            <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" Padding="20" StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Label Text="📘 DiaryHelper" FontSize="26" FontAttributes="Bold" TextColor="#1E293B" HorizontalOptions="Center" />
                    <Label Text="{Binding AppSubtitle}" 
                           FontSize="14" TextColor="#64748B" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- API Keys Section (Collapsible) -->
            <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" Padding="18" StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="14">
                    
                    <!-- Header with Tap Gesture to Toggle Expand/Collapse -->
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleApiKeysExpandedCommand}" />
                        </Grid.GestureRecognizers>

                        <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                            <Label Text="{Binding ApiKeysSectionTitle}" FontSize="17" FontAttributes="Bold" TextColor="#0F172A" />
                            <Label Text="{Binding ApiKeysStatusSubtitle}" FontSize="12" TextColor="#64748B" />
                        </VerticalStackLayout>

                        <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                            <!-- Status Pill Badge (if keys configured) -->
                            <Border IsVisible="{Binding HasApiKeys}"
                                    BackgroundColor="#DCFCE7"
                                    Stroke="#86EFAC"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="8,3"
                                    VerticalOptions="Center">
                                <Label Text="{Binding ApiKeysConfiguredText}" FontSize="11" FontAttributes="Bold" TextColor="#166534" />
                            </Border>

                            <!-- Chevron Toggle Button -->
                            <Button Text="{Binding ApiKeysChevronText}"
                                    Command="{Binding ToggleApiKeysExpandedCommand}"
                                    BackgroundColor="#F1F5F9"
                                    TextColor="#475569"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    CornerRadius="8"
                                    HeightRequest="32"
                                    WidthRequest="32"
                                    Padding="0" />
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Collapsible Content (visible when IsApiKeysExpanded is true) -->
                    <VerticalStackLayout Spacing="14" IsVisible="{Binding IsApiKeysExpanded}">
                        
                        <BoxView HeightRequest="1" Color="#F1F5F9" Margin="0,2,0,4" />

                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding MistralKeyLabel}" FontSize="13" FontAttributes="Bold" TextColor="#475569" />
                            <Entry Text="{Binding MistralApiKey}" 
                                   IsPassword="True" 
                                   Placeholder="{Binding MistralKeyPlaceholder}" 
                                   TextColor="#1E293B"
                                   BackgroundColor="#F1F5F9" />
                            <Label Text="{Binding MistralKeyHint}" FontSize="11" TextColor="#94A3B8" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding GoogleKeyLabel}" FontSize="13" FontAttributes="Bold" TextColor="#475569" />
                            <Entry Text="{Binding GoogleTranslateApiKey}" 
                                   IsPassword="True" 
                                   Placeholder="{Binding GoogleKeyPlaceholder}" 
                                   TextColor="#1E293B"
                                   BackgroundColor="#F1F5F9" />
                            <Label Text="{Binding GoogleKeyHint}" FontSize="11" TextColor="#94A3B8" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Languages & Persona Settings -->
            <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" Padding="20" StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="16">
                    <Label Text="{Binding LanguageSectionTitle}" FontSize="18" FontAttributes="Bold" TextColor="#0F172A" />

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="{Binding DiaryLanguageLabel}" FontSize="13" FontAttributes="Bold" TextColor="#475569" />
                            <Picker ItemsSource="{Binding SupportedLanguages}"
                                    ItemDisplayBinding="{Binding DisplayName}"
                                    SelectedItem="{Binding SelectedSourceLanguage}"
                                    BackgroundColor="#F1F5F9"
                                    TextColor="#1E293B" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="{Binding TranslationLanguageLabel}" FontSize="13" FontAttributes="Bold" TextColor="#475569" />
                            <Picker ItemsSource="{Binding SupportedLanguages}"
                                    ItemDisplayBinding="{Binding DisplayName}"
                                    SelectedItem="{Binding SelectedTargetLanguage}"
                                    BackgroundColor="#F1F5F9"
                                    TextColor="#1E293B" />
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding DefaultPersonaLabel}" FontSize="13" FontAttributes="Bold" TextColor="#475569" />
                        <Picker ItemsSource="{Binding AvailablePersonas}"
                                ItemDisplayBinding="{Binding DisplayName}"
                                SelectedItem="{Binding SelectedPersonaOption}"
                                BackgroundColor="#F1F5F9"
                                TextColor="#1E293B" />
                    </VerticalStackLayout>

                    <!-- Toggle for Bot Kick-Question Translation -->
                    <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding ShowBotPromptTranslationLabel}" FontSize="13" FontAttributes="Bold" TextColor="#475569" />
                            <Label Text="{Binding ShowBotPromptTranslationHint}" FontSize="11" TextColor="#94A3B8" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" 
                                IsToggled="{Binding ShowBotPromptTranslation}" 
                                OnColor="#4F46E5" 
                                ThumbColor="#FFFFFF" 
                                VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Actions -->
            <VerticalStackLayout Spacing="12">
                <Button Text="{Binding StartNewEntryButton}"
                        Command="{Binding StartNewEntryCommand}"
                        BackgroundColor="#4F46E5"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="52"
                        FontSize="16" />

                <Button Text="{Binding HistoryButton}"
                        Command="{Binding OpenHistoryCommand}"
                        BackgroundColor="White"
                        BorderColor="#E2E8F0"
                        BorderWidth="1"
                        TextColor="#334155"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="48"
                        FontSize="15" />

                <Button Text="{Binding SaveSettingsButton}"
                        Command="{Binding SaveSettingsCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#64748B"
                        FontSize="14" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
