<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DiaryHelper.ViewModels"
             xmlns:models="clr-namespace:DiaryHelper.Models"
             x:Class="DiaryHelper.Views.HistoryPage"
             x:DataType="vm:HistoryViewModel"
             Title="{Binding Title}"
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto, *">
        
        <!-- Top Toolbar -->
        <Border Grid.Row="0" BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" Padding="16,12" Margin="12,12,12,6" StrokeShape="RoundRectangle 14">
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="{Binding ArchiveHeader}" FontSize="18" FontAttributes="Bold" TextColor="#0F172A" />
                    <Label Text="{Binding ArchiveSubtitle}" FontSize="12" TextColor="#64748B" />
                </VerticalStackLayout>
                <Button Grid.Column="1" 
                        Text="{Binding NewButtonShort}" 
                        Command="{Binding StartNewEntryCommand}"
                        BackgroundColor="#4F46E5"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="40"
                        Padding="12,4" />
            </Grid>
        </Border>

        <!-- Entries List -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Entries}"
                        EmptyView="{Binding EmptyArchiveHint}"
                        Margin="12,6">
            
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:DiaryEntry">
                    <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" Padding="16" Margin="0,6" StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="10">
                            
                            <Grid ColumnDefinitions="*, Auto">
                                <HorizontalStackLayout Grid.Column="0" Spacing="8">
                                    <Label Text="📅" FontSize="16" />
                                    <Label Text="{Binding CreatedAt, StringFormat='{0:dd MMMM yyyy, HH:mm}'}" 
                                           FontSize="15" 
                                           FontAttributes="Bold" 
                                           TextColor="#1E293B" />
                                </HorizontalStackLayout>

                                <Border Grid.Column="1" 
                                        BackgroundColor="#F1F5F9" 
                                        Stroke="#CBD5E1" 
                                        StrokeThickness="1" 
                                        StrokeShape="RoundRectangle 8" 
                                        Padding="8,2">
                                    <HorizontalStackLayout Spacing="3">
                                        <Label Text="{Binding SentenceCount}" 
                                               FontSize="12" 
                                               FontAttributes="Bold" 
                                               TextColor="#475569" />
                                        <Label Text="{Binding Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, Path=SentencesCountSuffix}" 
                                               FontSize="12" 
                                               FontAttributes="Bold" 
                                               TextColor="#475569" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>

                            <!-- Preview Text -->
                            <Label Text="{Binding PreviewText}" 
                                   MaxLines="3" 
                                   LineBreakMode="TailTruncation"
                                   FontSize="14" 
                                   TextColor="#475569" />

                            <!-- Bottom Info & Buttons -->
                            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8" Margin="0,6,0,0">
                                <Label Grid.Column="0" 
                                       Text="{Binding SourceLanguage, StringFormat='Lang: {0}'}" 
                                       FontSize="12" 
                                       TextColor="#94A3B8" 
                                       VerticalOptions="Center" />

                                <Button Grid.Column="1" 
                                        Text="{Binding Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, Path=OpenButton}" 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, Path=OpenEntryCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#EEF2FF"
                                        TextColor="#4338CA"
                                        FontAttributes="Bold"
                                        CornerRadius="8"
                                        HeightRequest="36"
                                        Padding="12,2" />

                                <Button Grid.Column="2" 
                                        Text="{Binding Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, Path=DeleteButton}" 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, Path=DeleteEntryCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#FEE2E2"
                                        TextColor="#DC2626"
                                        CornerRadius="8"
                                        HeightRequest="36"
                                        Padding="12,2" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
