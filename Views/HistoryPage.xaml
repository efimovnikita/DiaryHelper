<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DiaryHelper.ViewModels"
             xmlns:models="clr-namespace:DiaryHelper.Models"
             x:Class="DiaryHelper.Views.HistoryPage"
             x:DataType="vm:HistoryViewModel"
             Title="{Binding Title}"
             BackgroundColor="#F8FAFC">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior Command="{Binding GoBackCommand}" IsEnabled="True" IsVisible="True" />
    </Shell.BackButtonBehavior>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{Binding NewButtonShort}" Command="{Binding StartNewEntryCommand}" Priority="0" Order="Primary" />
    </ContentPage.ToolbarItems>

    <!-- Entries List -->
    <CollectionView ItemsSource="{Binding Entries}"
                    EmptyView="{Binding EmptyArchiveHint}"
                    Margin="12,12">
            
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:DiaryEntry">
                    <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" Padding="16" Margin="0,6" StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="10">
                            
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding DisplayTitle}" 
                                           FontSize="15" 
                                           FontAttributes="Bold" 
                                           TextColor="#1E293B" />
                                    <Label Text="{Binding CreatedAt, StringFormat='📅 {0:dd MMMM yyyy, HH:mm}'}" 
                                           FontSize="12" 
                                           TextColor="#94A3B8" />
                                </VerticalStackLayout>

                                <Border Grid.Column="1" 
                                        VerticalOptions="Center"
                                        BackgroundColor="#F1F5F9" 
                                        Stroke="#CBD5E1" 
                                        StrokeThickness="1" 
                                        StrokeShape="RoundRectangle 8" 
                                        Padding="8,4">
                                    <HorizontalStackLayout Spacing="3" VerticalOptions="Center">
                                        <Label Text="{Binding SentenceCount}" 
                                               FontSize="12" 
                                               FontAttributes="Bold" 
                                               TextColor="#475569"
                                               VerticalTextAlignment="Center" />
                                        <Label Text="{Binding Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, Path=SentencesCountSuffix}" 
                                               FontSize="12" 
                                               FontAttributes="Bold" 
                                               TextColor="#475569"
                                               VerticalTextAlignment="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>

                            <!-- Preview Text -->
                            <Label Text="{Binding PreviewText}" 
                                   MaxLines="3" 
                                   LineBreakMode="TailTruncation"
                                   FontSize="14" 
                                   TextColor="#475569" />

                            <!-- Bottom Info & Buttons -->
                            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8" Margin="0,6,0,0">
                                <Label Grid.Column="0" 
                                       Text="{Binding SourceLanguage, StringFormat='Lang: {0}'}" 
                                       FontSize="12" 
                                       TextColor="#94A3B8" 
                                       VerticalOptions="Center" />

                                <Button Grid.Column="1" 
                                        Text="{Binding Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, Path=OpenButton}" 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, Path=OpenEntryCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#EEF2FF"
                                        TextColor="#4338CA"
                                        FontAttributes="Bold"
                                        CornerRadius="8"
                                        HeightRequest="36"
                                        Padding="12,2" />

                                <Button Grid.Column="2" 
                                        Text="{Binding Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, Path=DeleteButton}" 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, Path=DeleteEntryCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#FEE2E2"
                                        TextColor="#DC2626"
                                        CornerRadius="8"
                                        HeightRequest="36"
                                        Padding="12,2" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </ContentPage>
